  "cards": [
    {
      "dot": "emerald",
      "title": "Entry and exit",
      "items": [
        "Onboarding button, or CLAUDECOCKPIT_DEMO=1 at launch",
        "Every entry re-seeds a fresh copy retimed to now",
        "Exit waits for retired services, then deletes demo/ unless re-entered",
        "A normal launch deletes any leftover demo"
      ]
    },
    {
      "dot": "violet",
      "title": "Isolation",
      "items": [
        "Demo home is the home: SkillsKit refuses paths outside it",
        "Separate appdata, so the real sessions.db is never touched",
        "Coverage true inside demo/home only; RTK override ignored"
      ]
    },
    {
      "dot": "rose",
      "title": "Read-only in demo",
      "items": [
        "Transfer, import, delete, backup pruning refused in the store",
        "Grants, launch at login, config dir, RTK path disabled",
        "Resume shows a notice instead of copying a command"
      ]
    }
